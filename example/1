


#include <Arduino.h>

// 舵机控制配置
#define SERVO_PIN 19            // 信号引脚
#define PWM_FREQ 50             // 舵机PWM频率(标准50Hz)
#define PWM_CHANNEL 0           // LEDC通道(0~15)
#define PWM_RESOLUTION 10       // 分辨率(10位=0~1023)

// 舵机运行参数
const int minAngle = 0;         // 最小角度
const int maxAngle = 180;       // 最大角度
int currentAngle = 90;          // 当前角度
int foundMinAngle = 0;          // 找到的最小极限角度
int foundMaxAngle = 180;        // 找到的最大极限角度
bool exploreMode = false;       // 极限探索模式标志

// 角度转占空比计算函数
int angleToDuty(int angle) {
    // 约束角度范围（探索模式时不约束）
    if (!exploreMode) {
        angle = constrain(angle, minAngle, maxAngle);
    }
    
    // 脉冲宽度计算：0.5ms(0°) ~ 2.5ms(180°)
    float pulseWidth = 0.5 + (angle / 180.0) * 2.0; // 单位: ms
    float dutyCycle = (pulseWidth / 20.0) * 100.0;  // 占空比(%) 
    
    // 转换为10位分辨率整数值
    return (int)(dutyCycle * (1 << PWM_RESOLUTION) / 100);
}

// 设置舵机角度
void setServoAngle(int angle) {
    // 探索模式时不约束角度范围
    if (!exploreMode) {
        angle = constrain(angle, minAngle, maxAngle);
    }
    
    ledcWrite(PWM_CHANNEL, angleToDuty(angle));
    currentAngle = angle;
    Serial.printf("设置角度: %d°\n", angle);
}

// 平滑移动舵机到指定角度
void moveServoSmoothly(int targetAngle, int duration) {
    // 计算移动方向
    int direction = (targetAngle > currentAngle) ? 1 : -1;
    
    // 计算移动步数（每20ms移动一步）
    int steps = duration / 20;
    if (steps < 1) steps = 1;
    
    // 计算每步移动的角度
    float angleStep = (targetAngle - currentAngle) / (float)steps;
    
    // 逐步移动舵机
    for (int i = 0; i < steps; i++) {
        currentAngle += angleStep;
        ledcWrite(PWM_CHANNEL, angleToDuty(currentAngle));
        delay(20); // 每步间隔20ms
    }
    
    // 确保到达目标角度
    setServoAngle(targetAngle);
}

// 处理串口指令
void processSerialCommand() {
    if (Serial.available() > 0) {
        String input = Serial.readStringUntil('\n');
        input.trim();
        
        // 直接设置角度
        if (input.startsWith("SET ")) {
            int newAngle = input.substring(4).toInt();
            setServoAngle(newAngle);
            Serial.printf("已设置角度: %d°\n", newAngle);
        }
        // 平滑移动
        else if (input.startsWith("MOVE ")) {
            int spaceIndex = input.indexOf(' ', 5);
            if (spaceIndex > 0) {
                int targetAngle = input.substring(5, spaceIndex).toInt();
                int duration = input.substring(spaceIndex + 1).toInt();
                moveServoSmoothly(targetAngle, duration);
                Serial.printf("平滑移动到 %d° 用时 %dms\n", targetAngle, duration);
            }
        }
        // 进入探索模式
        else if (input.equalsIgnoreCase("EXPLORE ON")) {
            exploreMode = true;
            Serial.println("极限探索模式已开启");
        }
        // 退出探索模式
        else if (input.equalsIgnoreCase("EXPLORE OFF")) {
            exploreMode = false;
            Serial.println("极限探索模式已关闭");
        }
        // 设置最小极限角度
        else if (input.equalsIgnoreCase("SET MIN")) {
            foundMinAngle = currentAngle;
            Serial.printf("已设置最小极限角度: %d°\n", foundMinAngle);
        }
        // 设置最大极限角度
        else if (input.equalsIgnoreCase("SET MAX")) {
            foundMaxAngle = currentAngle;
            Serial.printf("已设置最大极限角度: %d°\n", foundMaxAngle);
        }
        // 显示当前信息
        else if (input.equalsIgnoreCase("INFO")) {
            Serial.println("\n====== 舵机控制系统 ======");
            Serial.printf("当前角度: %d°\n", currentAngle);
            Serial.printf("探索模式: %s\n", exploreMode ? "ON" : "OFF");
            Serial.printf("最小极限角度: %d°\n", foundMinAngle);
            Serial.printf("最大极限角度: %d°\n\n", foundMaxAngle);
            Serial.println("可用命令:");
            Serial.println("SET [角度] - 设置舵机角度");
            Serial.println("MOVE [角度] [时间(ms)] - 平滑移动");
            Serial.println("EXPLORE ON/OFF - 开启/关闭探索模式");
            Serial.println("SET MIN - 设置当前位置为最小极限");
            Serial.println("SET MAX - 设置当前位置为最大极限");
            Serial.println("INFO - 显示系统信息");
        }
    }
}

void setup() {
    // 初始化LEDC PWM
    ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);
    ledcAttachPin(SERVO_PIN, PWM_CHANNEL);
    
    Serial.begin(115200);
    Serial.println("舵机控制系统已启动");
    
    // 初始位置设为90°
    setServoAngle(90);
    delay(500);
    
    // 显示帮助信息
    Serial.println("输入 'INFO' 查看命令帮助");
}

void loop() {
    processSerialCommand();
    delay(50); // 减少CPU占用
}